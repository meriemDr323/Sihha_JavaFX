<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.hopitalapp.controller.admin.HospitalInfoFormController"
      spacing="15.0"
      style="-fx-background-color: #ffffff;">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label fx:id="titleLabel"
           text="Modifier les informations de l'hôpital"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>

    <GridPane hgap="10.0" vgap="8.0">
        <columnConstraints>
            <ColumnConstraints prefWidth="140.0"/>
            <ColumnConstraints prefWidth="320.0"/>
        </columnConstraints>

        <Label text="Nom:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nomField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Adresse:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="adresseField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Ville:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="villeField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Code postal:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="codePostalField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Téléphone:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="telephoneField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Email:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Site web:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="siteWebField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Nombre total de lits:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <TextField fx:id="nombreLitsField" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

        <Label text="Capacité urgences:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <TextField fx:id="capaciteUrgencesField" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

        <Label text="Logo (chemin):" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
        <TextField fx:id="logoPathField" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

        <Label text="Description:" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
        <TextArea fx:id="descriptionArea"
                  prefRowCount="4"
                  GridPane.rowIndex="10" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#handleCancel"
                style="-fx-background-color: #e0e0e0; -fx-text-fill: #333; -fx-padding: 8 16; -fx-background-radius: 5;"/>
        <Button fx:id="saveButton" text="Enregistrer" onAction="#handleSave"
                style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-padding: 8 16; -fx-background-radius: 5;"/>
    </HBox>

</VBox>
