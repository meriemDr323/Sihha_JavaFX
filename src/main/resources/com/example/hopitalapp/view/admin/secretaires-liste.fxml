<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.hopitalapp.controller.admin.SecretaireController"
      spacing="15.0"
      style="-fx-background-color: #f3f6fb;">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <!-- En-tête -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Label text="👩‍💼 Gestion des Secrétaires"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addButton" text="➕ Nouveau Secrétaire" onAction="#handleAddSecretaire"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5;"/>
    </HBox>

    <!-- Barre de recherche et statistiques -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <TextField fx:id="searchField" promptText="🔍 Rechercher par nom, prénom ou email..."
                   prefWidth="300.0"
                   style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 8 15;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="totalSecretairesLabel" text="Total: 0 secrétaire(s)"
               style="-fx-font-size: 14px; -fx-text-fill: #666; -fx-font-weight: bold;"/>
    </HBox>

    <!-- Tableau des secrétaires -->
    <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <padding>
            <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
        </padding>

        <TableView fx:id="secretairesTable" prefHeight="500.0">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="nomColumn" text="Nom" prefWidth="120"/>
                <TableColumn fx:id="prenomColumn" text="Prénom" prefWidth="120"/>
                <TableColumn fx:id="emailColumn" text="Email" prefWidth="200"/>
                <TableColumn fx:id="telephoneColumn" text="Téléphone" prefWidth="120"/>
                <TableColumn fx:id="adresseColumn" text="Adresse" prefWidth="150"/>
                <TableColumn fx:id="passwordColumn" text="Mot de passe" prefWidth="120"/>
                <TableColumn fx:id="statutColumn" text="Statut" prefWidth="80"/>
                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="180"/>
            </columns>
        </TableView>
    </VBox>

</VBox>