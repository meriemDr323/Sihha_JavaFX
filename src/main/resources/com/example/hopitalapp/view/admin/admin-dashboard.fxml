<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.hopitalapp.controller.admin.AdminDashboardController"
      spacing="20.0"
      style="-fx-background-color: #f3f6fb;">

    <padding>
        <Insets top="20.0" right="30.0" bottom="20.0" left="30.0"/>
    </padding>

    <Label text="Tableau de bord - Administration"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>

    <!-- Ligne de cartes KPI -->
    <HBox spacing="15.0">

        <VBox spacing="5.0"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0, 0, 3);"
              HBox.hgrow="ALWAYS">
            <Label text="👥 Patients"
                   style="-fx-font-size: 14px; -fx-text-fill: #546E7A;"/>
            <Label fx:id="patientsCountLabel"
                   text="0"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #263238;"/>
            <Label text="Total des patients enregistrés"
                   style="-fx-font-size: 11px; -fx-text-fill: #90A4AE;"/>
        </VBox>

        <VBox spacing="5.0"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0, 0, 3);"
              HBox.hgrow="ALWAYS">
            <Label text="👨‍⚕️ Médecins"
                   style="-fx-font-size: 14px; -fx-text-fill: #546E7A;"/>
            <Label fx:id="medecinsCountLabel"
                   text="0"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #263238;"/>
            <Label text="Médecins actifs dans l'hôpital"
                   style="-fx-font-size: 11px; -fx-text-fill: #90A4AE;"/>
        </VBox>

        <VBox spacing="5.0"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0, 0, 3);"
              HBox.hgrow="ALWAYS">
            <Label text="🏢 Départements"
                   style="-fx-font-size: 14px; -fx-text-fill: #546E7A;"/>
            <Label fx:id="departementsCountLabel"
                   text="0"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #263238;"/>
            <Label text="Unités de l'hôpital"
                   style="-fx-font-size: 11px; -fx-text-fill: #90A4AE;"/>
        </VBox>

        <VBox spacing="5.0"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0, 0, 3);"
              HBox.hgrow="ALWAYS">
            <Label text="📅 Rendez-vous"
                   style="-fx-font-size: 14px; -fx-text-fill: #546E7A;"/>
            <Label fx:id="rdvCountLabel"
                   text="0"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #263238;"/>
            <Label text="Rendez-vous planifiés (bientôt)"
                   style="-fx-font-size: 11px; -fx-text-fill: #90A4AE;"/>
        </VBox>
    </HBox>

    <!-- Zone d'activité récente avec design amélioré -->
    <VBox spacing="15.0"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
        
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="📊 Activité récente"
                   style="-fx-font-weight: bold; -fx-text-fill: #37474F; -fx-font-size: 18px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="7 derniers jours"
                   style="-fx-font-size: 12px; -fx-text-fill: #90A4AE; -fx-background-color: #E3F2FD; -fx-padding: 4 8; -fx-background-radius: 12;"/>
        </HBox>
        
        <ScrollPane fitToWidth="true" prefHeight="250" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox fx:id="activityContainer" spacing="8" style="-fx-padding: 5;"/>
        </ScrollPane>
        
        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10 0 0 0;">
            <Button text="🔄 Actualiser" onAction="#handleRefreshActivity"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 6 12; -fx-font-size: 11px;"/>
            <Button text="📋 Voir tout" onAction="#handleViewAllActivity"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 6 12; -fx-font-size: 11px;"/>
        </HBox>
    </VBox>

</VBox>
