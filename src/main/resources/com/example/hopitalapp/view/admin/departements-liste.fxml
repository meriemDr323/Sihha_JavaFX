<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.hopitalapp.controller.admin.DepartementController"
      spacing="20.0"
      style="-fx-background-color: #f5f5f5;">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Label text="🏥 Gestion des Départements"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addButton"
                text="+ Nouveau Département"
                onAction="#handleAddDepartement"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
    </HBox>

    <HBox spacing="15.0" alignment="CENTER_LEFT">
        <VBox spacing="5.0">
            <Label text="Rechercher un département:" style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
            <HBox spacing="10.0">
                <TextField fx:id="searchField"
                           promptText="Nom du département..."
                           prefWidth="300.0"
                           style="-fx-pref-height: 35px;"/>
                <Button text="🔍 Rechercher"
                        onAction="#handleSearch"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-pref-height: 35px; -fx-background-radius: 5; -fx-cursor: hand;"/>
                <Button text="🔄 Actualiser"
                        onAction="#handleRefresh"
                        style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-pref-height: 35px; -fx-background-radius: 5; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox alignment="CENTER" spacing="5.0"
              style="-fx-background-color: #E3F2FD; -fx-padding: 15; -fx-background-radius: 10;">
            <Label text="Total Départements" style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
            <Label fx:id="totalDepartementsLabel"
                   text="0"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
        </VBox>
    </HBox>

    <VBox VBox.vgrow="ALWAYS"
          style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
        <padding>
            <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
        </padding>

        <TableView fx:id="departementsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="60.0"/>
                <TableColumn fx:id="nomColumn" text="Nom" prefWidth="180.0"/>
                <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="220.0"/>
                <TableColumn fx:id="etageColumn" text="Étage" prefWidth="80.0"/>
                <TableColumn fx:id="nombreLitsColumn" text="Nb lits" prefWidth="80.0"/>
                <TableColumn fx:id="chefColumn" text="Chef de Service" prefWidth="180.0"/>
                <TableColumn fx:id="telephoneColumn" text="Téléphone" prefWidth="130.0"/>
                <TableColumn fx:id="emailColumn" text="Email Chef" prefWidth="200.0"/>
                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="260.0"/>
            </columns>
        </TableView>
    </VBox>

</VBox>
