<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.hopitalapp.controller.secretaire.SecretaireDashboardController"
      spacing="20.0"
      style="-fx-background-color: #f3f6fb;">

    <padding>
        <Insets top="20.0" right="30.0" bottom="20.0" left="30.0"/>
    </padding>

    <Label fx:id="welcomeLabel"
           text="Bonjour Secrétaire"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>

    <!-- Ligne de cartes KPI -->
    <HBox spacing="15.0">

        <VBox spacing="5.0"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0, 0, 3);"
              HBox.hgrow="ALWAYS">
            <Label text="📅 RDV Aujourd'hui"
                   style="-fx-font-size: 14px; -fx-text-fill: #546E7A;"/>
            <Label fx:id="rdvTodayLabel"
                   text="0"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #263238;"/>
            <Label text="Rendez-vous programmés"
                   style="-fx-font-size: 11px; -fx-text-fill: #90A4AE;"/>
        </VBox>

        <VBox spacing="5.0"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0, 0, 3);"
              HBox.hgrow="ALWAYS">
            <Label text="📊 RDV Cette Semaine"
                   style="-fx-font-size: 14px; -fx-text-fill: #546E7A;"/>
            <Label fx:id="rdvWeekLabel"
                   text="0"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #263238;"/>
            <Label text="Rendez-vous de la semaine"
                   style="-fx-font-size: 11px; -fx-text-fill: #90A4AE;"/>
        </VBox>

        <VBox spacing="5.0"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0, 0, 3);"
              HBox.hgrow="ALWAYS">
            <Label text="👥 Total Patients"
                   style="-fx-font-size: 14px; -fx-text-fill: #546E7A;"/>
            <Label fx:id="patientsCountLabel"
                   text="0"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #263238;"/>
            <Label text="Patients enregistrés"
                   style="-fx-font-size: 11px; -fx-text-fill: #90A4AE;"/>
        </VBox>

        <VBox spacing="5.0"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0, 0, 3);"
              HBox.hgrow="ALWAYS">
            <Label text="⏳ RDV En Attente"
                   style="-fx-font-size: 14px; -fx-text-fill: #546E7A;"/>
            <Label fx:id="rdvPendingLabel"
                   text="0"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #FF9800;"/>
            <Label text="À confirmer"
                   style="-fx-font-size: 11px; -fx-text-fill: #90A4AE;"/>
        </VBox>
    </HBox>

</VBox>