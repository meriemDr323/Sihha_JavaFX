<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.hopitalapp.controller.secretaire.SecretaireRendezVousFormController"
      spacing="20.0"
      style="-fx-background-color: white; -fx-padding: 20;">

    <!-- En-tête -->
    <HBox alignment="CENTER_LEFT">
        <Label fx:id="titleLabel"
               text="📅 Nouveau Rendez-vous"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2196F3;"/>
    </HBox>

    <Separator/>

    <!-- Formulaire -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox spacing="15.0">
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>

            <!-- Ligne 1: Patient et Médecin -->
            <HBox spacing="20.0">
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <Label text="Patient *" style="-fx-font-weight: bold; -fx-text-fill: #424242;"/>
                    <ComboBox fx:id="patientComboBox"
                              promptText="Sélectionner un patient..."
                              maxWidth="Infinity"
                              style="-fx-pref-height: 35px;"/>
                </VBox>

                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <Label text="Médecin *" style="-fx-font-weight: bold; -fx-text-fill: #424242;"/>
                    <ComboBox fx:id="medecinComboBox"
                              promptText="Sélectionner un médecin..."
                              maxWidth="Infinity"
                              style="-fx-pref-height: 35px;"/>
                </VBox>
            </HBox>

            <!-- Ligne 2: Date et Heure -->
            <HBox spacing="20.0">
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <Label text="Date *" style="-fx-font-weight: bold; -fx-text-fill: #424242;"/>
                    <DatePicker fx:id="datePicker"
                                promptText="Sélectionner une date..."
                                maxWidth="Infinity"
                                style="-fx-pref-height: 35px;"/>
                </VBox>

                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <Label text="Heure *" style="-fx-font-weight: bold; -fx-text-fill: #424242;"/>
                    <ComboBox fx:id="heureComboBox"
                              promptText="Sélectionner une heure..."
                              maxWidth="Infinity"
                              style="-fx-pref-height: 35px;"/>
                </VBox>

                <VBox spacing="8.0">
                    <Label text="Durée (min) *" style="-fx-font-weight: bold; -fx-text-fill: #424242;"/>
                    <ComboBox fx:id="dureeComboBox"
                              promptText="Durée..."
                              prefWidth="100.0"
                              style="-fx-pref-height: 35px;"/>
                </VBox>
            </HBox>

            <!-- Vérification de disponibilité -->
            <HBox spacing="15.0" alignment="CENTER_LEFT">
                <Button fx:id="checkDisponibiliteButton"
                        text="🔍 Vérifier Disponibilité"
                        onAction="#handleCheckDisponibilite"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 8 15; -fx-background-radius: 5; -fx-cursor: hand;"/>
                
                <Label fx:id="disponibiliteLabel"
                       text="Disponibilité non vérifiée"
                       visible="false"
                       style="-fx-font-weight: bold;"/>
            </HBox>

            <Separator/>

            <!-- Ligne 3: Motif -->
            <VBox spacing="8.0">
                <Label text="Motif de consultation *" style="-fx-font-weight: bold; -fx-text-fill: #424242;"/>
                <TextField fx:id="motifField"
                           promptText="Ex: Consultation générale, suivi, urgence..."
                           style="-fx-pref-height: 35px;"/>
            </VBox>

            <!-- Ligne 4: Statut -->
            <VBox spacing="8.0">
                <Label text="Statut" style="-fx-font-weight: bold; -fx-text-fill: #424242;"/>
                <ComboBox fx:id="statutComboBox"
                          prefWidth="200.0"
                          style="-fx-pref-height: 35px;"/>
            </VBox>

            <!-- Ligne 5: Notes -->
            <VBox spacing="8.0">
                <Label text="Notes (optionnel)" style="-fx-font-weight: bold; -fx-text-fill: #424242;"/>
                <TextArea fx:id="notesArea"
                          promptText="Notes additionnelles sur le rendez-vous..."
                          prefRowCount="3"
                          wrapText="true"/>
            </VBox>

        </VBox>
    </ScrollPane>

    <Separator/>

    <!-- Boutons -->
    <HBox spacing="15.0" alignment="CENTER_RIGHT">
        <Button text="Annuler"
                onAction="#handleCancel"
                style="-fx-background-color: #757575; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
        
        <Button fx:id="saveButton"
                text="Enregistrer"
                onAction="#handleSave"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
    </HBox>

</VBox>