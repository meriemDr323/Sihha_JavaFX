<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.hopitalapp.controller.secretaire.SecretaireRendezVousController"
      spacing="20.0"
      style="-fx-background-color: white;">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <!-- En-tête -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <Label text="📅 Gestion des Rendez-vous"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2196F3;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addButton"
                text="+ Nouveau RDV"
                onAction="#handleAddRendezVous"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
    </HBox>

    <!-- Barre de recherche et filtres -->
    <VBox spacing="15.0">
        <!-- Ligne 1: Recherche et filtres -->
        <HBox spacing="15.0" alignment="CENTER_LEFT">
            <VBox spacing="5.0">
                <Label text="Rechercher:" style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
                <TextField fx:id="searchField"
                           promptText="Patient, médecin, motif..."
                           prefWidth="250.0"
                           style="-fx-pref-height: 35px;"/>
            </VBox>
            
            <VBox spacing="5.0">
                <Label text="Statut:" style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
                <ComboBox fx:id="filterStatutComboBox"
                          prefWidth="130.0"
                          style="-fx-pref-height: 35px;"/>
            </VBox>
            
            <VBox spacing="5.0">
                <Label text="Médecin:" style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
                <ComboBox fx:id="filterMedecinComboBox"
                          prefWidth="180.0"
                          style="-fx-pref-height: 35px;"/>
            </VBox>
            
            <VBox spacing="5.0">
                <Label text="Date:" style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
                <DatePicker fx:id="filterDatePicker"
                            prefWidth="130.0"
                            style="-fx-pref-height: 35px;"/>
            </VBox>
            
            <VBox spacing="5.0">
                <Label text="Actions:" style="-fx-font-size: 12px; -fx-text-fill: transparent;"/>
                <HBox spacing="10.0">
                    <Button text="🔄 Actualiser"
                            onAction="#handleRefresh"
                            style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-pref-height: 35px; -fx-background-radius: 5; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <VBox alignment="CENTER" spacing="5.0"
                  style="-fx-background-color: #E8F5E8; -fx-padding: 15; -fx-background-radius: 10;">
                <Label text="RDV Affichés" style="-fx-font-size: 12px; -fx-text-fill: #757575;"/>
                <Label fx:id="totalRendezVousLabel"
                       text="0"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Tableau des rendez-vous -->
    <TableView fx:id="rendezVousTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50.0"/>
            <TableColumn fx:id="dateColumn" text="Date" prefWidth="90"/>
            <TableColumn fx:id="heureColumn" text="Heure" prefWidth="70"/>
            <TableColumn fx:id="patientColumn" text="Patient" prefWidth="120"/>
            <TableColumn fx:id="medecinColumn" text="Médecin" prefWidth="120"/>
            <TableColumn fx:id="motifColumn" text="Motif" prefWidth="150"/>
            <TableColumn fx:id="dureeColumn" text="Durée (min)" prefWidth="80"/>
            <TableColumn fx:id="statutColumn" text="Statut" prefWidth="100"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="200.0"/>
        </columns>
    </TableView>

</VBox>