<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.hopitalapp.controller.secretaire.SecretaireProfilController"
      spacing="15"
      style="-fx-background-color: linear-gradient(to bottom,#f3f6fb,#ffffff);">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Mon Profil"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>

    <!-- Section Informations personnelles -->
    <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.05),8,0,0,2);">
        <Label text="Informations personnelles "
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1565C0; -fx-padding: 0 0 10 0;"/>

        <GridPane hgap="12" vgap="10">
            <columnConstraints>
                <ColumnConstraints prefWidth="130"/>
                <ColumnConstraints prefWidth="280"/>
            </columnConstraints>

            <Label text="Nom:"
                   style="-fx-font-weight: bold; -fx-text-fill: #555;"
                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="nomField"
                       style="-fx-background-radius: 5; -fx-border-radius: 5;"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Prénom:"
                   style="-fx-font-weight: bold; -fx-text-fill: #555;"
                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="prenomField"
                       style="-fx-background-radius: 5; -fx-border-radius: 5;"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Email:"
                   style="-fx-font-weight: bold; -fx-text-fill: #555;"
                   GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="emailField"
                       style="-fx-background-radius: 5; -fx-border-radius: 5;"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Téléphone:"
                   style="-fx-font-weight: bold; -fx-text-fill: #555;"
                   GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="telephoneField"
                       style="-fx-background-radius: 5; -fx-border-radius: 5;"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Adresse:"
                   style="-fx-font-weight: bold; -fx-text-fill: #555;"
                   GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextArea fx:id="adresseArea"
                      prefRowCount="2"
                      style="-fx-background-radius: 5; -fx-border-radius: 5;"
                      GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>

    <!-- Section Changement de mot de passe -->
    <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.05),8,0,0,2);">
        <Label text="Changer le mot de passe"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1565C0; -fx-padding: 0 0 10 0;"/>

        <GridPane hgap="12" vgap="10">
            <columnConstraints>
                <ColumnConstraints prefWidth="130"/>
                <ColumnConstraints prefWidth="280"/>
            </columnConstraints>

            <Label text="Mot de passe actuel:"
                   style="-fx-font-weight: bold; -fx-text-fill: #555;"
                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <PasswordField fx:id="currentPasswordField"
                           style="-fx-background-radius: 5; -fx-border-radius: 5;"
                           GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Nouveau mot de passe:"
                   style="-fx-font-weight: bold; -fx-text-fill: #555;"
                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <PasswordField fx:id="newPasswordField"
                           style="-fx-background-radius: 5; -fx-border-radius: 5;"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Confirmer mot de passe:"
                   style="-fx-font-weight: bold; -fx-text-fill: #555;"
                   GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <PasswordField fx:id="confirmPasswordField"
                           style="-fx-background-radius: 5; -fx-border-radius: 5;"
                           GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>

        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 15 0 0 0;">
            <Button text="Vider les champs" onAction="#handleClearPasswordFields"
                    style="-fx-background-color: #ECEFF1; -fx-text-fill: #37474F; -fx-background-radius: 5;"/>
            <Button fx:id="changePasswordButton" text="Changer le mot de passe" onAction="#handleChangePassword"
                    style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"/>
        </HBox>
    </VBox>
</VBox>