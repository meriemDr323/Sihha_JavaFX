<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.hopitalapp.controller.secretaire.SecretaireDossierMedicalController"
      spacing="15.0"
      style="-fx-background-color: white; -fx-padding: 20;">

    <!-- En-tête Patient -->
    <VBox spacing="10.0"
          style="-fx-background-color: #E3F2FD; -fx-padding: 15; -fx-background-radius: 10;">
        <Label fx:id="patientNameLabel"
               text="Nom du Patient"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
        <Label fx:id="patientInfoLabel"
               text="Informations patient"
               style="-fx-font-size: 14px; -fx-text-fill: #424242;"/>
    </VBox>

    <!-- Titre -->
    <Label text="📋 Dossier Médical (Consultation seule)"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #424242;"/>

    <!-- Contenu principal -->
    <HBox spacing="20.0" VBox.vgrow="ALWAYS">
        
        <!-- Liste des consultations -->
        <VBox spacing="10.0" prefWidth="400.0">
            <Label text="Historique des consultations"
                   style="-fx-font-weight: bold; -fx-text-fill: #424242;"/>
            
            <TableView fx:id="dossierTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="100"/>
                    <TableColumn fx:id="medecinColumn" text="Médecin" prefWidth="120"/>
                    <TableColumn fx:id="diagnosticColumn" text="Diagnostic" prefWidth="120"/>
                    <TableColumn fx:id="symptomesColumn" text="Symptômes" prefWidth="100"/>
                    <TableColumn fx:id="traitementColumn" text="Traitement" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>

        <!-- Détails de la consultation sélectionnée -->
        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
            <Label text="Détails de la consultation"
                   style="-fx-font-weight: bold; -fx-text-fill: #424242;"/>
            
            <TextArea fx:id="detailsArea"
                      editable="false"
                      wrapText="true"
                      VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #FAFAFA; -fx-border-color: #E0E0E0; -fx-border-radius: 5; -fx-background-radius: 5;"/>
        </VBox>
    </HBox>

    <!-- Bouton fermer -->
    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="closeButton"
                text="Fermer"
                onAction="#handleClose"
                style="-fx-background-color: #757575; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;"/>
    </HBox>

</VBox>