<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.hopitalapp.controller.shared.RendezVousController"
      spacing="15.0"
      style="-fx-background-color: #f3f6fb;">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Gestion des Rendez-vous"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="searchField"
                   promptText="Rechercher par patient, médecin ou motif..."
                   prefWidth="260"/>
        <Button text="Rechercher" onAction="#handleSearch"/>
        <Button text="Actualiser" onAction="#handleRefresh"/>
        <Button text="Nouveau Rendez-vous"
                fx:id="addButton"
                onAction="#handleAddRendezVous"
                style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <TableView fx:id="rendezVousTable" prefHeight="400">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
            <TableColumn fx:id="dateColumn" text="Date &amp; heure" prefWidth="150"/>
            <TableColumn fx:id="patientColumn" text="Patient" prefWidth="180"/>
            <TableColumn fx:id="medecinColumn" text="Médecin" prefWidth="180"/>
            <TableColumn fx:id="motifColumn" text="Motif" prefWidth="220"/>
            <TableColumn fx:id="statutColumn" text="Statut" prefWidth="110"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="240"/>
        </columns>
    </TableView>

</VBox>
