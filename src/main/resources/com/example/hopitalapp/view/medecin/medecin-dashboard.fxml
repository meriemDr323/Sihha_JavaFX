<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.hopitalapp.controller.medecin.MedecinDashboardController"
      spacing="15"
      style="-fx-background-color: linear-gradient(to bottom,#f3f6fb,#ffffff);">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Tableau de bord Médecin"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>

    <Label fx:id="welcomeLabel"
           style="-fx-font-size: 16px; -fx-text-fill: #455A64;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="🔄 Actualiser" onAction="#handleRefresh"
                style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 8 12;"/>
    </HBox>

    <HBox spacing="20">
        <VBox spacing="5"
              style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.05),8,0,0,2);"
              HBox.hgrow="ALWAYS">
            <Label text="📅 RDV Aujourd'hui"
                   style="-fx-text-fill: #757575;"/>
            <Label fx:id="rdvTodayLabel"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
        </VBox>

        <VBox spacing="5"
              style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.05),8,0,0,2);"
              HBox.hgrow="ALWAYS">
            <Label text="📊 RDV Cette Semaine"
                   style="-fx-text-fill: #757575;"/>
            <Label fx:id="rdvWeekLabel"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #FF9800;"/>
        </VBox>

        <VBox spacing="5"
              style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.05),8,0,0,2);"
              HBox.hgrow="ALWAYS">
            <Label text="👥 Patients Suivis"
                   style="-fx-text-fill: #757575;"/>
            <Label fx:id="patientsCountLabel"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #388E3C;"/>
        </VBox>

        <VBox spacing="5"
              style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.05),8,0,0,2);"
              HBox.hgrow="ALWAYS">
            <Label text="⏳ RDV En Attente"
                   style="-fx-text-fill: #757575;"/>
            <Label fx:id="rdvPendingLabel"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #F44336;"/>
        </VBox>
    </HBox>

    <VBox spacing="10"
          style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.05),8,0,0,2);">
        <Label text="📅 Rendez-vous d'aujourd'hui"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>
        <ListView fx:id="todayAppointmentsList" prefHeight="150"
                  style="-fx-background-color: transparent; -fx-border-color: transparent;"/>
    </VBox>
</VBox>
