<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.hopitalapp.controller.medecin.MesPatientsController"
      spacing="15"
      style="-fx-background-color: #f3f6fb;">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Mes Patients"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1565C0;"/>

    <TextField fx:id="searchField" promptText="Rechercher par nom ou prénom..."
               style="-fx-background-radius: 5; -fx-border-radius: 5;"/>

    <TableView fx:id="patientsTable" prefHeight="420">
        <columns>
            <TableColumn fx:id="nomColumn" text="Nom" prefWidth="120"/>
            <TableColumn fx:id="prenomColumn" text="Prénom" prefWidth="120"/>
            <TableColumn fx:id="telephoneColumn" text="Téléphone" prefWidth="110"/>
            <TableColumn fx:id="ageColumn" text="Âge" prefWidth="60"/>
            <TableColumn fx:id="dernierRdvColumn" text="Dernier RDV" prefWidth="100"/>
            <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="250"/>
        </columns>
    </TableView>
</VBox>
